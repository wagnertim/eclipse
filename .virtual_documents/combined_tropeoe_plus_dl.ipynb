        plt.xlabel('Time [hours relative to max eclipse]')
        
        if imgctr==1:
            plt.ylabel('Height [km AGL]')
            
        


        saveDate[ctr] = eclipseDates[h]
        ctr = ctr+1
        imgctr = imgctr+1
        
        


